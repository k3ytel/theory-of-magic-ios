{
  "name": "theory-of-magic-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Capacitor iOS wrapper for Theory of Magic (Arcanum)",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "check:offline": "node scripts/check-offline.mjs www",
    "icon": "node scripts/make-icon.mjs",
    "sync": "npm run build:web && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@fontsource/open-sans": "5.3.0"
  }
}
